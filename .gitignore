external/cdda/
# D-1: track knowledge md only; check_*.log ignored everywhere (order-sensitive, ! negations before re-ignore)
logs/*
!logs/*.md
!logs/.gitkeep
check_*.log
*.swp
__pycache__/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.bak
*.egg-info/
build/
dist/
*.whl
# Generated / local runtime (do not commit; re-created on each run).
# NOTE: hats.yml / ralph.yml / .agents/planning/**/*.md are
# intentionally force-tracked knowledge files (git add -f, D-1) and stay
# tracked despite the ignore rules below. PROMPT.md is a local work prompt
# and stays untracked (do not `git add -f` it). Ignore prevents *new* runtime
# files from being added accidentally; do not `git add -f` new ones
# without a preservation reason.
.coverage*
htmlcov/
*.log
validation-*.log
validate-mods.log
verify-patches.log
.agents/
.kilo/plans/
# Local agent/runtime (untracked, do not commit; see NOTE above for exceptions)
.ralph/
PROMPT.md
hats.yml
opencode.json
ralph.yml
