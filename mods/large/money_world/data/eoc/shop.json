  {
    "type": "effect_on_condition",
    "id": "EOC_MW_BUY",
    "condition": {
      "and": [
        {
          "expects_vars": [
            "item_id",
            "price",
            "rank",
            "count"
          ]
        },
        {
          "math": [
            "u_mw_cents >= _price"
          ]
        },
        {
          "math": [
            "u_mw_rank >= _rank"
          ]
        }
      ]
    },
    "effect": [
      {
        "math": [
          "u_mw_cents = u_mw_cents - _price"
        ]
      },
      {
        "u_spawn_item": {
          "context_val": "item_id"
        },
        "count": {
          "context_val": "count"
        },
        "flags": [
          "TRADER_AVOID",
          "NO_SALVAGE"
        ]
      },
      {
        "u_message": "Purchased.",
        "type": "good"
      },
      {
        "run_eocs": "EOC_MW_SHOP"
      }
    ],
    "false_effect": [
      {
        "u_message": "Insufficient balance or account tier.",
        "type": "bad"
      },
      {
        "run_eocs": "EOC_MW_SHOP"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_MW_BUY_BLADE",
    "condition": {
      "and": [
        {
          "math": [
            "u_mw_cents >= 15000"
          ]
        },
        {
          "math": [
            "u_mw_rank >= 1"
          ]
        },
        {
          "math": [
            "u_mw_lease_until <= time( 'now' )"
          ]
        },
        {
          "not": {
            "u_has_item": "mw_lease_blade"
          }
        }
      ]
    },
    "effect": [
      {
        "math": [
          "u_mw_cents = u_mw_cents - 15000"
        ]
      },
      {
        "math": [
          "u_mw_lease_until = time( 'now' ) + 21600"
        ]
      },
      {
        "u_cast_spell": {
          "id": "mw_conjure_lease_blade"
        },
        "true_eocs": [
          "EOC_MW_BUY_BLADE_OK"
        ],
        "false_eocs": [
          "EOC_MW_BUY_BLADE_FAIL"
        ]
      }
    ],
    "false_effect": [
      {
        "u_message": "Insufficient balance, tier, or an active lease.",
        "type": "bad"
      },
      {
        "run_eocs": "EOC_MW_SHOP"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_MW_BUY_BLADE_OK",
    "effect": [
      {
        "u_message": "Lease active: monomolecular blade (6 hours).",
        "type": "good"
      },
      {
        "run_eocs": "EOC_MW_SHOP"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_MW_BUY_BLADE_FAIL",
    "effect": [
      {
        "math": [
          "u_mw_cents = u_mw_cents + 15000"
        ]
      },
      {
        "math": [
          "u_mw_lease_until = 0"
        ]
      },
      {
        "u_message": "Blade materialization failed; refunded.",
        "type": "bad"
      },
      {
        "run_eocs": "EOC_MW_SHOP"
      }
    ]
  },
