[
  {
    "type": "effect_on_condition",
    "id": "EOC_MW_REFRESH_RANK",
    "effect": [
      { "math": [ "_old_rank = u_mw_rank" ] },
      { "math": [ "u_mw_rank = u_mw_total_sold >= 50000 ? 2 : ( u_mw_total_sold >= 5000 ? 1 : 0 )" ] },
      {
        "if": { "math": [ "u_mw_rank > _old_rank" ] },
        "then": [ { "u_message": "Meridian account tier increased.", "type": "good" } ]
      }
    ]
  }
]
