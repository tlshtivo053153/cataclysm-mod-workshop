        "text": "topic で遷移（対照実験）",
        "topic": "TALK_ETT_CTX_OD_VIA_TOPIC"
      },
      {
        "text": "open_dialogue で遷移（本命テスト）",
        "topic": "TALK_ETT_CTX_OD_VIA_OD"
      },
      {
        "text": "戻る",
        "topic": "TALK_ETT_CTX_MENU"
      }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_ETT_CTX_OD_VIA_TOPIC",
    "dynamic_line": "response を選ぶと、effect で context_val を設定し、topic で TALK_ETT_CTX_OD_DISPLAY_VIA_TOPIC に遷移します。",
    "responses": [
      {
        "text": "実行",
        "effect": [
          { "set_string_var": "topic_transition_value", "target_var": { "context_val": "ett_ctx_od_test" } },
          { "set_string_var": "topic_transition_value_bk", "target_var": { "u_val": "ett_ctx_od_test_bk" } },
          { "u_message": "[CTX OD] topic経由: context_val=ett_ctx_od_test, u_val=ett_ctx_od_test_bk を設定", "type": "info" }
        ],
        "topic": "TALK_ETT_CTX_OD_DISPLAY_VIA_TOPIC"
      },
      {
        "text": "戻る",
        "topic": "TALK_ETT_CTX_OD_COMPARE"
      }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_ETT_CTX_OD_VIA_OD",
    "dynamic_line": "response で context_val を設定し、open_dialogue で別会話を開きます。\n\n2番目の選択肢（topic省略）は topic 未指定のため遷移先がなく、effect は実行されず COMPARE に戻ります。",
    "responses": [
      {
        "text": "実行",
        "effect": [
          { "set_string_var": "od_transition_value", "target_var": { "context_val": "ett_ctx_od_test" } },
          { "set_string_var": "od_transition_value_bk", "target_var": { "u_val": "ett_ctx_od_test_bk" } },
          { "u_message": "[CTX OD] open_dialogue経由: context_val=ett_ctx_od_test, u_val=ett_ctx_od_test_bk を設定", "type": "info" },
          { "open_dialogue": { "topic": "TALK_ETT_CTX_OD_DISPLAY_VIA_OD" } }
        ],
        "topic": "TALK_ETT_CTX_OD_COMPARE"
      },
      {
        "text": "open_dialogue で遷移（topic省略。effect未実行、COMPAREに戻る）",
        "effect": [
          { "set_string_var": "od_notopic_value", "target_var": { "context_val": "ett_ctx_od_test" } },
          { "set_string_var": "od_notopic_value_bk", "target_var": { "u_val": "ett_ctx_od_test_bk" } },
          { "u_message": "[CTX OD] ★このメッセージは表示されないはずです（topic省略時はeffect未実行のため）", "type": "info" },
          { "open_dialogue": { "topic": "TALK_ETT_CTX_OD_DISPLAY_VIA_OD_NOTOPIC" } }
        ]
      },
      {
        "text": "戻る",
        "topic": "TALK_ETT_CTX_OD_COMPARE"
      }
    ]
  },
  {
    "type": "talk_topic",
    "id": "TALK_ETT_CTX_OD_DISPLAY_VIA_TOPIC",
    "dynamic_line": "【topic 遷移】\ncontext_val: '<context_val:ett_ctx_od_test>'\nu_val fallback: '<u_val:ett_ctx_od_test_bk>'",
    "responses": [
      {
        "text": "戻る",
