  {
    "type": "talk_topic",
    "id": "TALK_ETT_CTX_OD_DISPLAY_VIA_OD_NOTOPIC",
    "dynamic_line": "【open_dialogue 遷移（topic省略）】\n\n★このトピックが表示されることは想定されていません。\ntopic省略時は遷移先がなく effect は実行されないため、open_dialogue も発火しません。\nこの画面が見えている場合、CDDA の仕様が変更された可能性があります。\n\ncontext_val: '<context_val:ett_ctx_od_test>'\nu_val fallback: '<u_val:ett_ctx_od_test_bk>'",
    "responses": [
      {
        "text": "戻る（TALK_DONE で会話終了）",
        "topic": "TALK_DONE"
      }
    ]
  }
