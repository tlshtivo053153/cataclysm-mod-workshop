[
  {
    "type": "effect_on_condition",
    "id": "wm_detect_category",
    "effect": [
      { "npc_add_var": "wm_wcat", "value": "unsupported" },
      {
        "if": { "npc_has_flag": "WM_SUPPORTED" },
        "then": [ { "npc_add_var": "wm_wcat", "value": "supported" } ]
      },
      {
        "if": {
          "and": [
            { "not": { "npc_has_flag": "WM_SUPPORTED" } },
            { "or": [
              { "u_has_wielded_with_skill": "bashing" },
              { "u_has_wielded_with_skill": "cutting" },
              { "u_has_wielded_with_skill": "stabbing" },
              { "u_has_wielded_with_skill": "unarmed" }
            ]}
          ]
        },
        "then": [ { "npc_add_var": "wm_wcat", "value": "melee" } ]
      },
      {
        "if": {
          "and": [
            { "not": { "npc_has_flag": "WM_SUPPORTED" } },
            { "or": [
              { "u_has_wielded_with_skill": "pistol" },
              { "u_has_wielded_with_skill": "rifle" },
              { "u_has_wielded_with_skill": "shotgun" },
              { "u_has_wielded_with_skill": "smg" },
              { "u_has_wielded_with_skill": "launcher" },
              { "u_has_wielded_with_skill": "archery" },
              { "u_has_wielded_with_skill": "throw" }
            ]}
          ]
        },
        "then": [ { "npc_add_var": "wm_wcat", "value": "ranged" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_on_kill_monster",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": "u_is_avatar",
    "effect": [
      { "u_message": "[WM] kill event fired", "type": "info" },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_add_xp" ]
      },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_add_xp",
    "effect": [
      {
        "if": { "not": { "compare_string": [ "unsupported", { "npc_val": "wm_wcat" } ] } },
        "then": [
          { "math": [ "n_wm_xp = n_wm_xp + 1" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_recheck",
    "recurrence": "30 seconds",
    "condition": "u_is_avatar",
    "effect": { "run_eocs": "wm_update_effects" }
  },
  {
    "type": "effect_on_condition",
    "id": "wm_on_wield_item",
    "eoc_type": "EVENT",
    "required_event": "character_wields_item",
    "condition": "u_is_avatar",
    "effect": [
      { "u_message": "[WM] wield event fired", "type": "info" },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_update_effects",
    "effect": [
      {
        "u_lose_effect": [
          "wm_buff_supported",
          "wm_buff_common"
        ]
      },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_apply_buffs" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_apply_buffs",
    "effect": [
      { "math": [ "u_wm_xp = n_wm_xp" ] },
      { "math": [ "u_wm_melee_damage = n_wm_buff_melee_damage" ] },
      { "math": [ "u_wm_melee_tohit = n_wm_buff_melee_tohit" ] },
      { "math": [ "u_wm_attack_speed = n_wm_buff_attack_speed" ] },
      { "math": [ "u_wm_ranged_damage = n_wm_buff_ranged_damage" ] },
      { "math": [ "u_wm_dispersion = n_wm_buff_dispersion" ] },
      {
        "if": { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "u_add_effect": "wm_buff_supported", "duration": "1 hour" }
        ]
      },
      {
        "if": { 
          "or": [
            { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
            { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] }
          ]
        },
        "then": [
          { "u_add_effect": "wm_buff_common", "duration": "1 hour" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_OPEN_DIALOGUE",
    "condition": "u_is_avatar",
    "effect": [
      { "run_eocs": "wm_update_effects" },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": "EOC_WM_DIALOGUE_DETECT"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_UPDATE_COST",
    "effect": [
      { "math": [ "u_wm_cost_melee_damage = n_wm_buff_melee_damage + 2" ] },
      { "math": [ "u_wm_cost_melee_tohit = n_wm_buff_melee_tohit + 2" ] },
      { "math": [ "u_wm_cost_attack_speed = n_wm_buff_attack_speed + 2" ] },
      { "math": [ "u_wm_cost_ranged_damage = n_wm_buff_ranged_damage + 2" ] },
      { "math": [ "u_wm_cost_dispersion = n_wm_buff_dispersion + 2" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_UPDATE_CAN_ENHANCE",
    "effect": [
      { "math": [ "_melee = 0" ] },
      { "math": [ "_ranged = 0" ] },
      {
        "if": { "compare_string": [ "unsupported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "u_message": "この武器は強化に対応していません。", "type": "bad" }
        ]
      },
      {
        "if": { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "_melee = 1" ] }
        ]
      },
      {
        "if": { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "_ranged = 1" ] }
        ]
      },
      {
        "if": { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "_melee = 1" ] },
          { "math": [ "_ranged = 1" ] }
        ]
      },
      {
        "math": [ "u_wm_can_enh_melee_damage = _melee * (n_wm_buff_melee_damage < 4)" ]
      },
      {
        "math": [ "u_wm_can_enh_melee_tohit = _melee * (n_wm_buff_melee_tohit < 4)" ]
      },
      {
        "math": [ "u_wm_can_enh_attack_speed = _melee * (n_wm_buff_attack_speed < 4)" ]
      },
      {
        "math": [ "u_wm_can_enh_ranged_damage = _ranged * (n_wm_buff_ranged_damage < 4)" ]
      },
      {
        "math": [ "u_wm_can_enh_dispersion = _ranged * (n_wm_buff_dispersion < 4)" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_REFRESH_ENHANCE_STATE",
    "effect": [
      { "run_eocs": [ "EOC_WM_UPDATE_COST", "EOC_WM_UPDATE_CAN_ENHANCE" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_DIALOGUE_DETECT",
    "effect": [
      { "run_eocs": "EOC_WM_REFRESH_ENHANCE_STATE" },
      { "open_dialogue": { "topic": "TALK_WM_ENHANCE" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_enhance_generic",
    "effect": [
      {
        "if": { "and": [
          { "math": [ "u_wm_enhance_type >= 1" ] },
          { "math": [ "u_wm_enhance_type <= 5" ] }
        ]},
        "then": [
          { 
            "if": { "math": [ "u_wm_enhance_type == 1" ] },
            "then": [
              { "set_string_var": "n_wm_buff_melee_damage", "target_var": { "context_val": "wm_upgrade_source" } },
              { "set_string_var": "近接ダメージ強化", "target_var": { "context_val": "upgrade_type"} }
            ]
          },
          { 
            "if": { "math": [ "u_wm_enhance_type == 2" ] },
            "then": [
              { "set_string_var": "n_wm_buff_melee_tohit", "target_var": { "context_val": "wm_upgrade_source" } },
              { "set_string_var": "近接命中強化", "target_var": { "context_val": "upgrade_type"} }
            ]
          },
          {
            "if": { "math": [ "u_wm_enhance_type == 3" ] },
            "then": [
              { "set_string_var": "n_wm_buff_attack_speed", "target_var": { "context_val": "wm_upgrade_source" } },
              { "set_string_var": "攻撃速度強化", "target_var": { "context_val": "upgrade_type"} }
            ]
          },
          { 
            "if": { "math": [ "u_wm_enhance_type == 4" ] },
            "then": [
              { "set_string_var": "n_wm_buff_ranged_damage", "target_var": { "context_val": "wm_upgrade_source" } },
              { "set_string_var": "遠隔ダメージ強化", "target_var": { "context_val": "upgrade_type"} }
            ]
          },
          { 
            "if": { "math": [ "u_wm_enhance_type == 5" ] },
            "then": [
              { "set_string_var": "n_wm_buff_dispersion", "target_var": { "context_val": "wm_upgrade_source" } },
              { "set_string_var": "遠隔精度強化", "target_var": { "context_val": "upgrade_type"} }
            ]
          },
          { "copy_var": { "var_val": "wm_upgrade_source" }, "target_var": { "npc_val": "wm_upgrade_tier" } },
          { "math": [ "_need_upgrade_exp = n_wm_upgrade_tier + 2" ] },
          { "math": [ "u_wm_upgrade_result = 3" ] },
          {
            "if": { "math": [ "n_wm_upgrade_tier >= 4" ] },
            "then": [ { "math": [ "u_wm_upgrade_result = 2" ] } ]
          },
          {
            "if": { "and": [
              { "math": [ "n_wm_upgrade_tier < 4" ] },
              { "math": [ "n_wm_xp >= _need_upgrade_exp" ] }
            ]},
            "then": [
              { "math": [ "n_wm_xp -= _need_upgrade_exp" ] },
              { "math": [ "n_wm_upgrade_tier ++" ] },
              { "math": [ "u_wm_upgrade_result = 1" ] }
            ]
          },
          { "copy_var": { "npc_val": "wm_upgrade_tier" }, "target_var": { "var_val": "wm_upgrade_source" } },
          { "if": { "math": [ "u_wm_upgrade_result == 1" ] }, "then": [ { "u_message": "<context_val:upgrade_type> Tier <npc_val:wm_upgrade_tier> を取得しました！", "type": "good" } ] },
          { "if": { "math": [ "u_wm_upgrade_result == 2" ] }, "then": [ { "u_message": "<context_val:upgrade_type>は既に最大レベルです。", "type": "bad" } ] },
          { "if": { "math": [ "u_wm_upgrade_result == 3" ] }, "then": [ { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" } ] }
        ],
        "else": [
          { "u_message": "内部エラー: 不明な強化タイプです。", "type": "bad" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_GENERIC_ENHANCE",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_enhance_generic" ]
      },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "WM_TEST_VARVAL_TARGET",
    "effect": [
      { "math": [ "u_test_var_a = 99" ] },
      { "set_string_var": "u_test_var_b", "target_var": { "context_val": "test_target_name" } },
      { "copy_var": { "u_val": "test_var_a" }, "target_var": { "var_val": "test_target_name" } },
      { "u_message": "var_val target test: u_test_var_b = <u_val:test_var_b> (expect 99)", "type": "info" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_test_math_comparison",
    "effect": [
      { "math": [ "u_wm_test_a = 2" ] },
      { "math": [ "u_wm_test_less = (u_wm_test_a < 4)" ] },
      { "math": [ "u_wm_test_gte = (u_wm_test_a >= 4)" ] },
      { "u_message": "TEST less (2＜4 expect 1): <u_val:wm_test_less>", "type": "info" },
      { "u_message": "TEST gte (2>=4 expect 0): <u_val:wm_test_gte>", "type": "info" },
      { "math": [ "u_wm_test_a = 4" ] },
      { "math": [ "u_wm_test_less = (u_wm_test_a < 4)" ] },
      { "math": [ "u_wm_test_gte = (u_wm_test_a >= 4)" ] },
      { "u_message": "TEST less (4＜4 expect 0): <u_val:wm_test_less>", "type": "info" },
      { "u_message": "TEST gte (4>=4 expect 1): <u_val:wm_test_gte>", "type": "info" },
      { "math": [ "u_wm_test_flag = 1" ] },
      { "math": [ "u_wm_test_result = u_wm_test_flag * (u_wm_test_a < 4)" ] },
      { "u_message": "TEST gate flag=1 a=4: <u_val:wm_test_result> (expect 0)", "type": "info" },
      { "math": [ "u_wm_test_flag = 0" ] },
      { "math": [ "u_wm_test_result = u_wm_test_flag * (u_wm_test_a < 4)" ] },
      { "u_message": "TEST gate flag=0 a=4: <u_val:wm_test_result> (expect 0)", "type": "info" },
      { "math": [ "u_wm_test_flag = 1" ] },
      { "math": [ "u_wm_test_a = 2" ] },
      { "math": [ "u_wm_test_result = u_wm_test_flag * (u_wm_test_a < 4)" ] },
      { "u_message": "TEST gate flag=1 a=2: <u_val:wm_test_result> (expect 1)", "type": "info" },
      { "u_message": "WM math comparison test complete. All expect: 1,0,0,1,0,0,1", "type": "good" }
    ]
  }
]
