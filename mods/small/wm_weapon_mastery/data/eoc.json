[
  {
    "type": "effect_on_condition",
    "id": "wm_detect_category",
    "effect": [
      { "npc_add_var": "wm_wcat", "value": "unsupported" },
      {
        "if": { "npc_has_flag": "WM_SUPPORTED" },
        "then": [ { "npc_add_var": "wm_wcat", "value": "supported" } ]
      },
      {
        "if": {
          "and": [
            { "not": { "npc_has_flag": "WM_SUPPORTED" } },
            { "or": [
              { "u_has_wielded_with_skill": "bashing" },
              { "u_has_wielded_with_skill": "cutting" },
              { "u_has_wielded_with_skill": "stabbing" },
              { "u_has_wielded_with_skill": "unarmed" }
            ]}
          ]
        },
        "then": [ { "npc_add_var": "wm_wcat", "value": "melee" } ]
      },
      {
        "if": {
          "and": [
            { "not": { "npc_has_flag": "WM_SUPPORTED" } },
            { "or": [
              { "u_has_wielded_with_skill": "pistol" },
              { "u_has_wielded_with_skill": "rifle" },
              { "u_has_wielded_with_skill": "shotgun" },
              { "u_has_wielded_with_skill": "smg" },
              { "u_has_wielded_with_skill": "launcher" },
              { "u_has_wielded_with_skill": "archery" },
              { "u_has_wielded_with_skill": "throw" }
            ]}
          ]
        },
        "then": [ { "npc_add_var": "wm_wcat", "value": "ranged" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_on_kill_monster",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": "u_is_avatar",
    "effect": [
      { "u_message": "[WM] kill event fired", "type": "info" },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_add_xp" ]
      },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_add_xp",
    "effect": [
      {
        "if": { "not": { "compare_string": [ "unsupported", { "npc_val": "wm_wcat" } ] } },
        "then": [
          { "math": [ "n_wm_xp = n_wm_xp + 1" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_recheck",
    "recurrence": "30 seconds",
    "condition": "u_is_avatar",
    "effect": { "run_eocs": "wm_update_effects" }
  },
  {
    "type": "effect_on_condition",
    "id": "wm_on_wield_item",
    "eoc_type": "EVENT",
    "required_event": "character_wields_item",
    "condition": "u_is_avatar",
    "effect": [
      { "u_message": "[WM] wield event fired", "type": "info" },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_update_effects",
    "effect": [
      {
        "u_lose_effect": [
          "wm_buff_supported",
          "wm_buff_melee",
          "wm_buff_ranged"
        ]
      },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_apply_buffs" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_apply_buffs",
    "effect": [
      { "math": [ "u_wm_xp = n_wm_xp" ] },
      { "math": [ "u_wm_melee_damage = 0" ] },
      { "math": [ "u_wm_melee_tohit = 0" ] },
      { "math": [ "u_wm_attack_speed = 0" ] },
      { "math": [ "u_wm_ranged_damage = 0" ] },
      { "math": [ "u_wm_dispersion = 0" ] },
      {
        "if": { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_melee_damage = n_wm_buff_melee_damage" ] },
          { "math": [ "u_wm_melee_tohit = n_wm_buff_melee_tohit" ] },
          { "math": [ "u_wm_attack_speed = n_wm_buff_attack_speed" ] },
          { "math": [ "u_wm_ranged_damage = n_wm_buff_ranged_damage" ] },
          { "math": [ "u_wm_dispersion = n_wm_buff_dispersion" ] },
          { "u_add_effect": "wm_buff_supported", "duration": "1 hour" }
        ]
      },
      {
        "if": { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_melee_damage = n_wm_buff_melee_damage" ] },
          { "math": [ "u_wm_melee_tohit = n_wm_buff_melee_tohit" ] },
          { "math": [ "u_wm_attack_speed = n_wm_buff_attack_speed" ] },
          { "math": [ "u_wm_ranged_damage = 0" ] },
          { "math": [ "u_wm_dispersion = 0" ] },
          { "u_add_effect": "wm_buff_melee", "duration": "1 hour" }
        ]
      },
      {
        "if": { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_melee_damage = 0" ] },
          { "math": [ "u_wm_melee_tohit = 0" ] },
          { "math": [ "u_wm_attack_speed = 0" ] },
          { "math": [ "u_wm_ranged_damage = n_wm_buff_ranged_damage" ] },
          { "math": [ "u_wm_dispersion = n_wm_buff_dispersion" ] },
          { "u_add_effect": "wm_buff_ranged", "duration": "1 hour" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_OPEN_DIALOGUE",
    "condition": "u_is_avatar",
    "effect": [
      { "run_eocs": "wm_update_effects" },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_open_dialogue_detect" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_open_dialogue_detect",
    "effect": [
      {
        "if": { "compare_string": [ "unsupported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_can_melee = 0" ] },
          { "math": [ "u_wm_can_ranged = 0" ] },
          { "u_message": "この武器は強化に対応していません。", "type": "bad" }
        ]
      },
      {
        "if": { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_can_melee = 1" ] },
          { "math": [ "u_wm_can_ranged = 0" ] },
          { "open_dialogue": { "topic": "TALK_WM_ENHANCE" } }
        ]
      },
      {
        "if": { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_can_melee = 0" ] },
          { "math": [ "u_wm_can_ranged = 1" ] },
          { "open_dialogue": { "topic": "TALK_WM_ENHANCE" } }
        ]
      },
      {
        "if": { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_can_melee = 1" ] },
          { "math": [ "u_wm_can_ranged = 1" ] },
          { "open_dialogue": { "topic": "TALK_WM_ENHANCE" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_enhance_generic",
    "effect": [
      {
        "if": {
          "or": [
            { "and": [
              { "math": [ "u_wm_enhance_type <= 3" ] },
              { "or": [
                { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
                { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] }
              ]}
            ]},
            { "and": [
              { "math": [ "u_wm_enhance_type >= 4" ] },
              { "or": [
                { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
                { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] }
              ]}
            ]}
          ]
        },
        "then": [
          {
            "if": { "and": [
              { "math": [ "u_wm_enhance_type >= 1" ] },
              { "math": [ "u_wm_enhance_type <= 5" ] }
            ]},
            "then": [
              { "if": { "math": [ "u_wm_enhance_type == 1" ] }, "then": [ { "set_string_var": "n_wm_buff_melee_damage", "target_var": { "context_val": "wm_upgrade_source" } } ] },
              { "if": { "math": [ "u_wm_enhance_type == 2" ] }, "then": [ { "set_string_var": "n_wm_buff_melee_tohit", "target_var": { "context_val": "wm_upgrade_source" } } ] },
              { "if": { "math": [ "u_wm_enhance_type == 3" ] }, "then": [ { "set_string_var": "n_wm_buff_attack_speed", "target_var": { "context_val": "wm_upgrade_source" } } ] },
              { "if": { "math": [ "u_wm_enhance_type == 4" ] }, "then": [ { "set_string_var": "n_wm_buff_ranged_damage", "target_var": { "context_val": "wm_upgrade_source" } } ] },
              { "if": { "math": [ "u_wm_enhance_type == 5" ] }, "then": [ { "set_string_var": "n_wm_buff_dispersion", "target_var": { "context_val": "wm_upgrade_source" } } ] },
              { "copy_var": { "var_val": "wm_upgrade_source" }, "target_var": { "npc_val": "wm_upgrade_tier" } },
              { "math": [ "u_wm_upgrade_result = 3" ] },
              {
                "if": { "math": [ "n_wm_upgrade_tier >= 4" ] },
                "then": [ { "math": [ "u_wm_upgrade_result = 2" ] } ]
              },
              {
                "if": { "and": [
                  { "math": [ "n_wm_upgrade_tier < 4" ] },
                  { "math": [ "n_wm_xp >= (n_wm_upgrade_tier + 2)" ] }
                ]},
                "then": [
                  { "math": [ "n_wm_xp = n_wm_xp - (n_wm_upgrade_tier + 2)" ] },
                  { "math": [ "n_wm_upgrade_tier = n_wm_upgrade_tier + 1" ] },
                  { "math": [ "u_wm_upgrade_result = 1" ] }
                ]
              },
              { "copy_var": { "npc_val": "wm_upgrade_tier" }, "target_var": { "var_val": "wm_upgrade_source" } },
              {
                "switch": { "math": [ "u_wm_enhance_type" ] },
                "cases": [
                  {
                    "case": 1,
                    "effect": [
                      { "if": { "math": [ "u_wm_upgrade_result == 1" ] }, "then": [ { "u_message": "近接ダメージ強化 Tier <npc_val:wm_buff_melee_damage> を取得しました！", "type": "good" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 2" ] }, "then": [ { "u_message": "近接ダメージは既に最大レベルです。", "type": "bad" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 3" ] }, "then": [ { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" } ] }
                    ]
                  },
                  {
                    "case": 2,
                    "effect": [
                      { "if": { "math": [ "u_wm_upgrade_result == 1" ] }, "then": [ { "u_message": "近接命中強化 Tier <npc_val:wm_buff_melee_tohit> を取得しました！", "type": "good" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 2" ] }, "then": [ { "u_message": "近接命中は既に最大レベルです。", "type": "bad" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 3" ] }, "then": [ { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" } ] }
                    ]
                  },
                  {
                    "case": 3,
                    "effect": [
                      { "if": { "math": [ "u_wm_upgrade_result == 1" ] }, "then": [ { "u_message": "攻撃速度強化 Tier <npc_val:wm_buff_attack_speed> を取得しました！", "type": "good" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 2" ] }, "then": [ { "u_message": "攻撃速度は既に最大レベルです。", "type": "bad" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 3" ] }, "then": [ { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" } ] }
                    ]
                  },
                  {
                    "case": 4,
                    "effect": [
                      { "if": { "math": [ "u_wm_upgrade_result == 1" ] }, "then": [ { "u_message": "遠隔ダメージ強化 Tier <npc_val:wm_buff_ranged_damage> を取得しました！", "type": "good" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 2" ] }, "then": [ { "u_message": "遠隔ダメージは既に最大レベルです。", "type": "bad" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 3" ] }, "then": [ { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" } ] }
                    ]
                  },
                  {
                    "case": 5,
                    "effect": [
                      { "if": { "math": [ "u_wm_upgrade_result == 1" ] }, "then": [ { "u_message": "遠隔精度強化 Tier <npc_val:wm_buff_dispersion> を取得しました！", "type": "good" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 2" ] }, "then": [ { "u_message": "遠隔精度は既に最大レベルです。", "type": "bad" } ] },
                      { "if": { "math": [ "u_wm_upgrade_result == 3" ] }, "then": [ { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" } ] }
                    ]
                  }
                ]
              }
            ],
            "else": [
              { "u_message": "内部エラー: 不明な強化タイプです。", "type": "bad" }
            ]
          }
        ],
        "else": [
          { "u_message": "この武器ではこの強化は利用できません。", "type": "bad" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_GENERIC_ENHANCE",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_enhance_generic" ]
      },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_RETURN_TO_DIALOGUE",
    "effect": { "open_dialogue": { "topic": "TALK_WM_ENHANCE" } }
  },
  {
    "type": "effect_on_condition",
    "id": "WM_TEST_VARVAL_TARGET",
    "effect": [
      { "math": [ "u_test_var_a = 99" ] },
      { "set_string_var": "u_test_var_b", "target_var": { "context_val": "test_target_name" } },
      { "copy_var": { "u_val": "test_var_a" }, "target_var": { "var_val": "test_target_name" } },
      { "u_message": "var_val target test: u_test_var_b = <u_val:test_var_b> (expect 99)", "type": "info" }
    ]
  }
]
