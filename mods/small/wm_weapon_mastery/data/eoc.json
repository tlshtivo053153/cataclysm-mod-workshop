  {
    "type": "effect_on_condition",
    "id": "wm_enhance_melee_damage_nested",
    "effect": [
      {
        "if": {
          "or": [
            { "npc_has_flag": "WM_SUPPORTED" },
            {
              "or": [
                { "u_has_wielded_with_skill": "bashing" },
                { "u_has_wielded_with_skill": "cutting" },
                { "u_has_wielded_with_skill": "piercing" },
                { "u_has_wielded_with_skill": "unarmed" }
              ]
            }
          ]
        },
        "then": [
          {
            "if": { "math": [ "n_wm_buff_melee_damage >= 4" ] },
            "then": [
              { "u_message": "近接ダメージは既に最大レベルです。", "type": "bad" }
            ],
            "else": [
              {
                "if": { "math": [ "n_wm_buff_melee_damage == 0" ] },
                "then": [
                  {
                    "if": { "math": [ "n_wm_xp >= 2" ] },
                    "then": [
                      { "math": [ "n_wm_xp = n_wm_xp - 2" ] },
                      { "math": [ "n_wm_buff_melee_damage = 1" ] },
                      { "u_message": "近接ダメージ強化 Tier 1 を取得しました！ (消費XP: 2)", "type": "good" }
                    ],
                    "else": [
                      { "u_message": "XPが不足しています。必要XP: 2 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                    ]
                  }
                ]
              },
              {
                "if": { "math": [ "n_wm_buff_melee_damage == 1" ] },
                "then": [
                  {
                    "if": { "math": [ "n_wm_xp >= 3" ] },
                    "then": [
                      { "math": [ "n_wm_xp = n_wm_xp - 3" ] },
                      { "math": [ "n_wm_buff_melee_damage = 2" ] },
                      { "u_message": "近接ダメージ強化 Tier 2 を取得しました！ (消費XP: 3)", "type": "good" }
                    ],
                    "else": [
                      { "u_message": "XPが不足しています。必要XP: 3 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                    ]
                  }
                ]
              },
              {
                "if": { "math": [ "n_wm_buff_melee_damage == 2" ] },
                "then": [
                  {
                    "if": { "math": [ "n_wm_xp >= 4" ] },
                    "then": [
                      { "math": [ "n_wm_xp = n_wm_xp - 4" ] },
                      { "math": [ "n_wm_buff_melee_damage = 3" ] },
                      { "u_message": "近接ダメージ強化 Tier 3 を取得しました！ (消費XP: 4)", "type": "good" }
                    ],
                    "else": [
                      { "u_message": "XPが不足しています。必要XP: 4 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                    ]
                  }
                ]
              },
              {
                "if": { "math": [ "n_wm_buff_melee_damage == 3" ] },
                "then": [
                  {
                    "if": { "math": [ "n_wm_xp >= 5" ] },
                    "then": [
                      { "math": [ "n_wm_xp = n_wm_xp - 5" ] },
                      { "math": [ "n_wm_buff_melee_damage = 4" ] },
                      { "u_message": "近接ダメージ強化 Tier 4 を取得しました！ (消費XP: 5)", "type": "good" }
                    ],
                    "else": [
                      { "u_message": "XPが不足しています。必要XP: 5 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                    ]
                  }
                ]
              }
            ]
          }
        ],
        "else": [
          { "u_message": "この武器では近接ダメージ強化は利用できません。", "type": "bad" }
        ]
      }
    ]
  },
