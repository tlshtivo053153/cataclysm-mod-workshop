[
  {
    "type": "effect_on_condition",
    "id": "wm_detect_category",
    "effect": [
      { "npc_add_var": "wm_wcat", "value": "unsupported" },
      {
        "if": { "npc_has_flag": "WM_SUPPORTED" },
        "then": [ { "npc_add_var": "wm_wcat", "value": "supported" } ]
      },
      {
        "if": {
          "and": [
            { "not": { "npc_has_flag": "WM_SUPPORTED" } },
            { "or": [
              { "u_has_wielded_with_skill": "bashing" },
              { "u_has_wielded_with_skill": "cutting" },
              { "u_has_wielded_with_skill": "stabbing" },
              { "u_has_wielded_with_skill": "unarmed" }
            ]}
          ]
        },
        "then": [ { "npc_add_var": "wm_wcat", "value": "melee" } ]
      },
      {
        "if": {
          "and": [
            { "not": { "npc_has_flag": "WM_SUPPORTED" } },
            { "or": [
              { "u_has_wielded_with_skill": "pistol" },
              { "u_has_wielded_with_skill": "rifle" },
              { "u_has_wielded_with_skill": "shotgun" },
              { "u_has_wielded_with_skill": "smg" },
              { "u_has_wielded_with_skill": "launcher" },
              { "u_has_wielded_with_skill": "archery" },
              { "u_has_wielded_with_skill": "throw" }
            ]}
          ]
        },
        "then": [ { "npc_add_var": "wm_wcat", "value": "ranged" } ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_on_kill_monster",
    "eoc_type": "EVENT",
    "required_event": "character_kills_monster",
    "condition": "u_is_avatar",
    "effect": [
      { "u_message": "[WM] kill event fired", "type": "info" },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_add_xp" ]
      },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_add_xp",
    "effect": [
      {
        "if": { "not": { "compare_string": [ "unsupported", { "npc_val": "wm_wcat" } ] } },
        "then": [
          { "math": [ "n_wm_xp = n_wm_xp + 1" ] }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_recheck",
    "recurrence": "30 seconds",
    "condition": "u_is_avatar",
    "effect": { "run_eocs": "wm_update_effects" }
  },
  {
    "type": "effect_on_condition",
    "id": "wm_on_wield_item",
    "eoc_type": "EVENT",
    "required_event": "character_wields_item",
    "condition": "u_is_avatar",
    "effect": [
      { "u_message": "[WM] wield event fired", "type": "info" },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_update_effects",
    "effect": [
      {
        "u_lose_effect": [
          "wm_buff_supported",
          "wm_buff_melee",
          "wm_buff_ranged"
        ]
      },
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_apply_buffs" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_apply_buffs",
    "effect": [
      { "math": [ "u_wm_melee_damage = 0" ] },
      { "math": [ "u_wm_melee_tohit = 0" ] },
      { "math": [ "u_wm_attack_speed = 0" ] },
      { "math": [ "u_wm_ranged_damage = 0" ] },
      { "math": [ "u_wm_dispersion = 0" ] },
      {
        "if": { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_melee_damage = n_wm_buff_melee_damage" ] },
          { "math": [ "u_wm_melee_tohit = n_wm_buff_melee_tohit" ] },
          { "math": [ "u_wm_attack_speed = n_wm_buff_attack_speed" ] },
          { "math": [ "u_wm_ranged_damage = n_wm_buff_ranged_damage" ] },
          { "math": [ "u_wm_dispersion = n_wm_buff_dispersion" ] },
          { "u_add_effect": "wm_buff_supported", "duration": "1 hour" }
        ]
      },
      {
        "if": { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_melee_damage = n_wm_buff_melee_damage" ] },
          { "math": [ "u_wm_melee_tohit = n_wm_buff_melee_tohit" ] },
          { "math": [ "u_wm_attack_speed = n_wm_buff_attack_speed" ] },
          { "math": [ "u_wm_ranged_damage = 0" ] },
          { "math": [ "u_wm_dispersion = 0" ] },
          { "u_add_effect": "wm_buff_melee", "duration": "1 hour" }
        ]
      },
      {
        "if": { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_melee_damage = 0" ] },
          { "math": [ "u_wm_melee_tohit = 0" ] },
          { "math": [ "u_wm_attack_speed = 0" ] },
          { "math": [ "u_wm_ranged_damage = n_wm_buff_ranged_damage" ] },
          { "math": [ "u_wm_dispersion = n_wm_buff_dispersion" ] },
          { "u_add_effect": "wm_buff_ranged", "duration": "1 hour" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_OPEN_DIALOGUE",
    "condition": "u_is_avatar",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_open_dialogue_detect" ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_open_dialogue_detect",
    "effect": [
      {
        "if": { "compare_string": [ "unsupported", { "npc_val": "wm_wcat" } ] },
        "then": [ { "u_message": "この武器は強化に対応していません。", "type": "bad" } ]
      },
      {
        "if": { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_last_dialogue = 1" ] },
          { "open_dialogue": { "topic": "TALK_WM_ENHANCE_MELEE" } }
        ]
      },
      {
        "if": { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_last_dialogue = 2" ] },
          { "open_dialogue": { "topic": "TALK_WM_ENHANCE_RANGED" } }
        ]
      },
      {
        "if": { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] },
        "then": [
          { "math": [ "u_wm_last_dialogue = 3" ] },
          { "open_dialogue": { "topic": "TALK_WM_ENHANCE_SUPPORTED" } }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "wm_enhance_generic",
    "effect": [
      {
        "if": {
          "or": [
            { "and": [
              { "math": [ "u_wm_enhance_type <= 3" ] },
              { "or": [
                { "compare_string": [ "melee", { "npc_val": "wm_wcat" } ] },
                { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] }
              ]}
            ]},
            { "and": [
              { "math": [ "u_wm_enhance_type >= 4" ] },
              { "or": [
                { "compare_string": [ "ranged", { "npc_val": "wm_wcat" } ] },
                { "compare_string": [ "supported", { "npc_val": "wm_wcat" } ] }
              ]}
            ]}
          ]
        },
        "then": [
          {
            "if": { "math": [ "u_wm_enhance_type == 1" ] },
            "then": [
              {
                "if": { "math": [ "n_wm_buff_melee_damage >= 4" ] },
                "then": [
                  { "u_message": "近接ダメージは既に最大レベルです。", "type": "bad" }
                ],
                "else": [
                  {
                    "if": { "math": [ "n_wm_xp >= (n_wm_buff_melee_damage + 2)" ] },
                    "then": [
                      { "math": [ "n_wm_xp = n_wm_xp - (n_wm_buff_melee_damage + 2)" ] },
                      { "math": [ "n_wm_buff_melee_damage = n_wm_buff_melee_damage + 1" ] },
                      { "u_message": "近接ダメージ強化 Tier <npc_val:wm_buff_melee_damage> を取得しました！", "type": "good" }
                    ],
                    "else": [
                      { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                    ]
                  }
                ]
              }
            ],
            "else": {
              "if": { "math": [ "u_wm_enhance_type == 2" ] },
              "then": [
                {
                  "if": { "math": [ "n_wm_buff_melee_tohit >= 4" ] },
                  "then": [
                    { "u_message": "近接命中は既に最大レベルです。", "type": "bad" }
                  ],
                  "else": [
                    {
                      "if": { "math": [ "n_wm_xp >= (n_wm_buff_melee_tohit + 2)" ] },
                      "then": [
                        { "math": [ "n_wm_xp = n_wm_xp - (n_wm_buff_melee_tohit + 2)" ] },
                        { "math": [ "n_wm_buff_melee_tohit = n_wm_buff_melee_tohit + 1" ] },
                        { "u_message": "近接命中強化 Tier <npc_val:wm_buff_melee_tohit> を取得しました！", "type": "good" }
                      ],
                      "else": [
                        { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                      ]
                    }
                  ]
                }
              ],
              "else": {
                "if": { "math": [ "u_wm_enhance_type == 3" ] },
                "then": [
                  {
                    "if": { "math": [ "n_wm_buff_attack_speed >= 4" ] },
                    "then": [
                      { "u_message": "攻撃速度は既に最大レベルです。", "type": "bad" }
                    ],
                    "else": [
                      {
                        "if": { "math": [ "n_wm_xp >= (n_wm_buff_attack_speed + 2)" ] },
                        "then": [
                          { "math": [ "n_wm_xp = n_wm_xp - (n_wm_buff_attack_speed + 2)" ] },
                          { "math": [ "n_wm_buff_attack_speed = n_wm_buff_attack_speed + 1" ] },
                          { "u_message": "攻撃速度強化 Tier <npc_val:wm_buff_attack_speed> を取得しました！", "type": "good" }
                        ],
                        "else": [
                          { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                        ]
                      }
                    ]
                  }
                ],
                "else": {
                  "if": { "math": [ "u_wm_enhance_type == 4" ] },
                  "then": [
                    {
                      "if": { "math": [ "n_wm_buff_ranged_damage >= 4" ] },
                      "then": [
                        { "u_message": "遠隔ダメージは既に最大レベルです。", "type": "bad" }
                      ],
                      "else": [
                        {
                          "if": { "math": [ "n_wm_xp >= (n_wm_buff_ranged_damage + 2)" ] },
                          "then": [
                            { "math": [ "n_wm_xp = n_wm_xp - (n_wm_buff_ranged_damage + 2)" ] },
                            { "math": [ "n_wm_buff_ranged_damage = n_wm_buff_ranged_damage + 1" ] },
                            { "u_message": "遠隔ダメージ強化 Tier <npc_val:wm_buff_ranged_damage> を取得しました！", "type": "good" }
                          ],
                          "else": [
                            { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                          ]
                        }
                      ]
                    }
                  ],
                  "else": {
                    "if": { "math": [ "u_wm_enhance_type == 5" ] },
                    "then": [
                      {
                        "if": { "math": [ "n_wm_buff_dispersion >= 4" ] },
                        "then": [
                          { "u_message": "遠隔精度は既に最大レベルです。", "type": "bad" }
                        ],
                        "else": [
                          {
                            "if": { "math": [ "n_wm_xp >= (n_wm_buff_dispersion + 2)" ] },
                            "then": [
                              { "math": [ "n_wm_xp = n_wm_xp - (n_wm_buff_dispersion + 2)" ] },
                              { "math": [ "n_wm_buff_dispersion = n_wm_buff_dispersion + 1" ] },
                              { "u_message": "遠隔精度強化 Tier <npc_val:wm_buff_dispersion> を取得しました！", "type": "good" }
                            ],
                            "else": [
                              { "u_message": "XPが不足しています。 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
                            ]
                          }
                        ]
                      }
                    ],
                    "else": [
                      { "u_message": "内部エラー: 不明な強化タイプです。", "type": "bad" }
                    ]
                  }
                }
              }
            }
          }
        ],
        "else": [
          { "u_message": "この武器ではこの強化は利用できません。", "type": "bad" }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_GENERIC_ENHANCE",
    "effect": [
      {
        "u_run_inv_eocs": "all",
        "search_data": [ { "wielded_only": true } ],
        "true_eocs": [ "wm_detect_category", "wm_enhance_generic" ]
      },
      { "run_eocs": "wm_update_effects" }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_WM_RETURN_TO_DIALOGUE",
    "effect": [
      {
        "if": { "math": [ "u_wm_last_dialogue == 1" ] },
        "then": [ { "open_dialogue": { "topic": "TALK_WM_ENHANCE_MELEE" } } ]
      },
      {
        "if": { "math": [ "u_wm_last_dialogue == 2" ] },
        "then": [ { "open_dialogue": { "topic": "TALK_WM_ENHANCE_RANGED" } } ]
      },
      {
        "if": { "math": [ "u_wm_last_dialogue == 3" ] },
        "then": [ { "open_dialogue": { "topic": "TALK_WM_ENHANCE_SUPPORTED" } } ]
      }
    ]
  }
]
