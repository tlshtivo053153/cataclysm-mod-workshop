                      { "u_message": "近接ダメージ強化 Tier 3 を取得しました！ (消費XP: 4)", "type": "good" }
                    ],
                    "else": [
                      { "u_message": "XPが不足しています。必要XP: 4 (現在XP: <npc_val:wm_xp>)", "type": "bad" }
